    },
    {
      "name": "The IsPacketDone event indicates whether a packet has completed or not. It will return BOOLEAN_TRUE if the packet played to the end, was stopped or failed due to an error.",
      "file_offset": "0x10babb0",
      "preferred_data_va": "0x14bb7b0"
    },
    {
      "name": "It will return BOOLEAN_FALSE if the packet is still to be played.",
