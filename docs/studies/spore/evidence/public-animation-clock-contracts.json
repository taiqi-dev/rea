  "contracts": [
    {
      "source": "C01",
      "locator": "lines43,69–71,108,139–145,220,258–264",
      "fact": "ANIM length is an LE float at 0x120; text length is emitted/parsed as a float without unit conversion. Writer emits fixed word 0x3d088889 at 0x11c. Reader does not expose 0x11c as a field; read calls fixVersion.",
      "limit": "Producer constant is not a native clock consumer. Preserve raw resource version; no seconds/FPS conversion established."
    },
    {
      "source": "C02",
      "locator": "lines38–39,47–68,128–131",
      "fact": "INFO record time is LE int32 at +0; eventStart LE uint16 at +8 and count byte at +10; writer preserves integer time. Text parser bounds integer time to 0..(int)(animation.length-1). Binary reader is not that validity check.",
      "limit": "No unit conversion, frame multiplication, interpolation or gameplay-effect dispatch implementation here. Type and raw bounds support index-like interpretation only as inference."
    },
    {
      "source": "C03",
      "locator": "lines30–41,45–55",
      "fact": "durationScale defaults 1 and duration defaults -1; for version>8 they are BE floats preceding animationID and UTF16LE description.",
      "limit": "Native meaning of -1 and multiply/divide playback formula unknown."
    },
    {
      "source": "C04",
      "locator": "lines39–46,48–82,123–160,219–222,256–257",
      "fact": "Old TLSA group read shares one durationScale/duration pair across its animations; new layout contains a pair per animation reference. blendInTime, allowLocomotion, endMode and version10 randomizeChoicePerLoop are represented separately.",
      "limit": "No runtime speed, transition curve, loop-end enum interpretation or sentinel resolution; presence does not prove target simultaneous gameplay skills."
    },
    {
      "source": "C05",
      "locator": "lines33–34",
      "fact": "SDK names 0x11c frameLength (comment 1/30) and 0x120 length.",
      "limit": "Declaration/comment only, not validated native consumer/ABI; does not prove INFO integer time is frames or clip duration equals length*frameLength."
    },
    {
      "source": "C06",
      "locator": "lines31–36",
      "fact": "IAnimWorld declares Update/UpdateCreatures/PostUpdateCreatures with float deltaTime. Comment suggests delta seconds with a question mark.",
      "limit": "Uncertain community annotation stays uncertain. Actual update sequence, rate and pause ownership not recovered."
    },
    {
      "source": "C07",
      "locator": "lines71–90,104–106,162–190",
      "fact": "SetAnimationBlendInTime, SetLoop, SetLoopTimes, GetCurrentAnimation(dstTime), GetAnimationLength and anim_query duration/durationScale/blendInTime fields exist. SetLoopTimes comment permits fractional counts, >1 only with looping, and -1 indefinite.",
      "limit": "Community documented interface, not target execution. Unnamed float methods remain unnamed; field_A8 comment current time? is not a verified progress field. No rate/pause consumer."
    },
    {
      "source": "C08",
      "locator": "lines139–158,179–182",
      "fact": "Ability has mAnimationIDs, mEffectDuration, mRefresh, mDuration, mRecharge and mReactionDuration as separate declarations.",
      "limit": "No original-unit or equality rule connecting ability duration, effect duration, recharge and animation length."
    },
    {
      "source": "C09",
      "locator": "lines14–32,48–52",
      "fact": "GAIT step-length key stores speedi and stepLength as LE floats; text parser/writer preserve those floats.",
      "limit": "No velocity unit or native frequency formula in this format class."
    },
    {
      "source": "C10",
      "locator": "lines53–95,97–139",
      "fact": "GAIT group key stores speedi and phase/bias fields, then LE int taxonCount/pathDataCount, paired LE float trigger/duty values and path records. Writer mirrors this order.",
      "limit": "No actual legs-to-slot map, native trigger phase origin or runtime interpolation implementation."
    },
    {
      "source": "C11",
      "locator": "lines84–108,134–143",
      "fact": "AnimEditor Timer at 2000ms schedules file lastModified polling and reload.",
      "limit": "Excluded as playback clock evidence; editor file reload is not game animation advancement."
    }
  ],
